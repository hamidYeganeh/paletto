# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Set MONGO_MEMORY=1 to boot an in-memory MongoDB instance automatically
# (useful for local development/tests without Docker). Set to 0 to use MONGO_URI.
MONGO_MEMORY=1
MONGO_URI=mongodb://127.0.0.1:27017/paletto

# Redis (optional - the API degrades gracefully with in-memory fallbacks if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=paletto-dev-secret
JWT_EXPIRES_IN=7d

# OTP
OTP_DEV_CODE=123456
OTP_TTL_SECONDS=300

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
